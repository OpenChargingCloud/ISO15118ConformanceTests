# Licensed standards, kept locally and never redistributed.
# The ISO 15118 documents are ISO's copyright and are licensed per copy -- the same reason
# libs/EVSimulatorApp/libs/WWCP_ISO15118/**/Schemas/ carries only a placeholder README and the
# build fetches the schemas under ISO's Customer Licence Agreement. Findings derived from these
# documents belong in docs/ as clause references and requirement IDs; the text itself does not.
onlyLocalDoNotCommit/

# Build output
[Bb]in/
[Oo]bj/
[Oo]ut/

# Visual Studio / Rider / VS Code
.vs/
.vscode/
.idea/
*.user
# One developer's command line for a runnable project, written when Visual Studio opens or launches it.
**/Properties/launchSettings.json
*.suo
*.userosscache
*.sln.docstates

# Test / coverage results
[Tt]est[Rr]esults/
*.trx
*.coverage
*.coveragexml
coverage*.json

# NuGet
*.nupkg
packages/
.nuget/

# OS cruft
Thumbs.db
.DS_Store

# cbv2g-ref: the fetched libcbv2g and CMake build tree live outside the repo
# (WSL ~/cbv2g-ref-build). Nothing to ignore here, but keep local build dirs out:
tools/**/build/
tools/**/cmake-build-*/

# walk20.py imports roundtrip20 as a module, which leaves bytecode next to it.
tools/**/__pycache__/

# EVerest's own session logs. Evse15118D20 writes one YAML per session into its working directory,
# named strftime("%y%m%d_%H-%M-%S.yaml") (session_logger.cpp:27,128) -- so an interop run driven from
# this tree leaves a handful in the root. They are their artifact, not ours: the run notes carry the
# frames we recorded ourselves, and these would be a second, unreviewed copy of somebody else's log.
[0-9][0-9][01][0-9][0-3][0-9]_[0-2][0-9]-[0-5][0-9]-[0-5][0-9].yaml
