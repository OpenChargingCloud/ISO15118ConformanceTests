<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit"                   Version="4.2.2"   />
    <PackageReference Include="NUnit3TestAdapter"       Version="4.6.0"   />
    <PackageReference Include="NUnit.Analyzers"         Version="4.3.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\libs\EVSimulatorApp\libs\WWCP_ISO15118\WWCP_ISO15118_Session\WWCP_ISO15118_Session.csproj" />
    <!-- The OCPP recorder is the app's, not the protocol library's: it writes the third leg of the
         metering comparison (docs/CONCEPT.md §4.3) and is a stub of a different protocol. It reaches the
         state machines through ISessionBackend, never the other way round. -->
    <ProjectReference Include="..\libs\EVSimulatorApp\simulation\EVSimulatorApp.Ocpp\EVSimulatorApp.Ocpp.csproj" />
    <ProjectReference Include="..\libs\EVSimulatorApp\libs\WWCP_ISO15118\WWCP_ISO15118_EVCC\WWCP_ISO15118_EVCC.csproj" />
    <ProjectReference Include="..\libs\EVSimulatorApp\libs\WWCP_ISO15118\WWCP_ISO15118_SECC\WWCP_ISO15118_SECC.csproj" />
    <!-- Test-only: the WWCP V2G PKI builder (submodule) generates a real strict-20 certificate
         hierarchy for the mutual-TLS E2E tests. Shipping code stays certificate-agnostic. -->
    <ProjectReference Include="..\libs\EVSimulatorApp\libs\WWCP_ISO15118\WWCP_ISO15118_PKI\WWCP_ISO15118_PKIBuilder\WWCP_ISO15118_PKIBuilder.csproj" />
  </ItemGroup>

  <!-- The corpus these tests record and every port is held to. It lives in the EVSimulatorApp
       submodule, in `vectors/`, because that is where the things held to it live: Swift, Kotlin,
       TypeScript, the WebView app and the Capacitor plugin all read it, and reading it out of THIS
       repository made a submodule depend on its own superproject. The regenerators here write
       there; both sets are linked into one `Vectors` folder beside the assembly, so the read paths
       in these tests are unchanged.

       `Din.tesla-session.corpus.json` stays here: no port reads it, it belongs to the DIN interop
       tests alone. -->
  <ItemGroup>
    <None Include="Vectors\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\libs\EVSimulatorApp\vectors\*.json">
      <Link>Vectors\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
