<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <RootNamespace>Vanaheimr.V2G.Iso15118_20.AC</RootNamespace>
    <AssemblyName>Vanaheimr.V2G.Exi.Iso15118_20.AC</AssemblyName>
    <IsAotCompatible>true</IsAotCompatible>

    <!-- The generator reads these to name the generated codec, so it does not collide with the
         CommonMessages/-2/AppProtocol codecs (all from the same source generator). -->
    <ExiGeneratedNamespace>Vanaheimr.V2G.Iso15118_20.AC.Generated</ExiGeneratedNamespace>
    <ExiCodecClassName>AcCodec</ExiCodecClassName>

    <!-- Write the generated codec to obj/ for inspection. -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="ExiGeneratedNamespace" />
    <CompilerVisibleProperty Include="ExiCodecClassName" />
    <CompilerVisibleProperty Include="ExiFragmentElements" />
  </ItemGroup>

  <ItemGroup>
    <!-- AC + the CommonTypes/xmldsig it imports, as one collected set. CommonTypes is deliberately
         duplicated per message-set assembly (mirrors cbexigen/cbV2G itself). -->
    <AdditionalFiles Include="Schemas\V2G_CI_AC.xsd" />
    <AdditionalFiles Include="Schemas\V2G_CI_CommonTypes.xsd" />
    <AdditionalFiles Include="Schemas\xmldsig-core-schema.xsd" />
  </ItemGroup>

  <ItemGroup>
    <!-- The generated codec uses BitWriter / BitReader / ExiPrimitives from the prototype. -->
    <ProjectReference Include="..\Vanaheimr.V2G.Exi.Prototype\Vanaheimr.V2G.Exi.Prototype.csproj" />
    <ProjectReference Include="..\Vanaheimr.V2G.Exi.SourceGenerator\Vanaheimr.V2G.Exi.SourceGenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
