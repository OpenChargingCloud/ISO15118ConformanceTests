<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <RootNamespace>Vanaheimr.V2G.Simulation</RootNamespace>
    <AssemblyName>Vanaheimr.V2G.Simulation</AssemblyName>
    <!-- The BouncyCastle TLS backend (Transport/BouncyCastle/) is not AOT/trim-clean, so the
         AOT-compatible guarantee is dropped. The default TLS path stays .NET SslStream. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Managed TLS stack for the ISO 15118-20-faithful TLS profile (P-521 / Ed448, exact -20
         cipher-suite & curve pinning) that Windows Schannel cannot provide. Opt-in backend. -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- V2GTP header + SAP codec (Prototype), payload-type dispatch (Dispatch), and the four
         message-set codecs this slice actually drives. WPT/ACDP are out of scope here. -->
    <ProjectReference Include="..\Vanaheimr.V2G.Exi.Prototype\Vanaheimr.V2G.Exi.Prototype.csproj" />
    <ProjectReference Include="..\Vanaheimr.V2G.Exi.Dispatch\Vanaheimr.V2G.Exi.Dispatch.csproj" />
    <ProjectReference Include="..\Vanaheimr.V2G.Exi.Iso15118_2\Vanaheimr.V2G.Exi.Iso15118_2.csproj" />
    <ProjectReference Include="..\Vanaheimr.V2G.Exi.Iso15118_20.CommonMessages\Vanaheimr.V2G.Exi.Iso15118_20.CommonMessages.csproj" />
    <ProjectReference Include="..\Vanaheimr.V2G.Exi.Iso15118_20.DC\Vanaheimr.V2G.Exi.Iso15118_20.DC.csproj" />
    <ProjectReference Include="..\Vanaheimr.V2G.Exi.Iso15118_20.AC\Vanaheimr.V2G.Exi.Iso15118_20.AC.csproj" />
  </ItemGroup>
</Project>
